{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"project": ["*.{js,ts}"]
		},
		"packages/localhost2137": {
			"entry": [
				"type-fixtures/authoring-inference.ts",
				"test/fixtures/config-project/**/localhost.config.ts"
			],
