{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"project": ["*.{js,ts}"]
		},
		"examples/slack-ping-bot": {
			"ignoreDependencies": ["undici"]
		},
		"packages/localhost2137": {
			"entry": ["type-fixtures/*.ts", "test/fixtures/config-project/**/localhost.config.ts"],
			"ignore": ["demo-assets/**"],
			"project": ["src/**/*.ts", "test/**/*.ts", "type-fixtures/**/*.ts"]
		},
		"packages/plugin-testkit": {
			"entry": [
				"src/authoring-child.ts",
				"src/durability-supervisor.ts",
				"test/fixtures/authoring-output.config.ts",
				"type-fixtures/public-inference.ts"
			],
			"project": ["src/**/*.ts", "test/**/*.ts", "type-fixtures/**/*.ts"]
		},
		"plugins/slack": {
			"project": [
				"scripts/**/*.mjs",
				"src/**/*.ts",
				"test/**/*.ts",
				"ui/src/**/*.{css,ts,tsx}",
				"ui/*.ts"
			]
		},
		"plugins/*": {
			"project": ["src/**/*.ts", "test/**/*.ts"]
		}
	}
}
