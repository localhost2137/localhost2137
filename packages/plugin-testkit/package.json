{
	"name": "@localhost2137/plugin-testkit",
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -b",
		"typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
		"typecheck:fixtures": "tsc -p tsconfig.type-fixtures.json --pretty false"
	},
	"peerDependencies": {
		"localhost2137": "0.0.0"
	},
	"devDependencies": {
		"hono": "4.13.4",
		"localhost2137": "workspace:*",
		"zod": "4.4.3"
	}
}
