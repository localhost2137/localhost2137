{
	"name": "@localhost2137/slack",
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"assets/ui",
		"dist",
		"README.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "pnpm build:ui && tsc -b",
		"build:ui": "vite build --config ui/vite.config.ts",
		"pack:ui:check": "node scripts/check-dashboard-pack.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p ui/tsconfig.json --pretty false",
		"typecheck:test": "tsc -p tsconfig.test.json --pretty false",
		"typecheck:ui": "tsc -p ui/tsconfig.json --pretty false"
	},
	"dependencies": {
		"@hono/node-server": "2.1.1",
		"@types/better-sqlite3": "7.6.13",
		"better-sqlite3": "^13.0.3",
		"hono": "4.13.4",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@fontsource/lato": "5.3.0",
		"@localhost2137/plugin-testkit": "workspace:*",
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"localhost2137": "workspace:*",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwindcss": "4.3.3",
		"vite": "8.2.2"
	},
	"peerDependencies": {
		"localhost2137": "workspace:*"
	}
}
