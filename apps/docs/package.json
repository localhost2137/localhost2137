		"fumadocs-mdx": "15.3.1",
		"fumadocs-ui": "16.15.1",
		"next": "16.3.3",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"@types/mdx": "2.0.14",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3"
	}
}
