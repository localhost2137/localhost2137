{
	"name": "@localhost2137/docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm typegen && next build",
		"check:content": "node scripts/check-content.mjs",
